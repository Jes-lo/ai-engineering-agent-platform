AI_PLATFORM_ENVIRONMENT=development
AI_PLATFORM_DOCS_ENABLED=true
AI_PLATFORM_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_PLATFORM_OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# PostgreSQL application runtime
AI_PLATFORM_POSTGRES_HOST=127.0.0.1
AI_PLATFORM_POSTGRES_PORT=5432
AI_PLATFORM_POSTGRES_DATABASE=ai_platform
AI_PLATFORM_POSTGRES_USER=ai_platform_runtime
AI_PLATFORM_POSTGRES_PASSWORD=set-via-secret-manager
AI_PLATFORM_POSTGRES_SSLMODE=prefer
AI_PLATFORM_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
AI_PLATFORM_POSTGRES_POOL_MIN_SIZE=1
AI_PLATFORM_POSTGRES_POOL_MAX_SIZE=5
AI_PLATFORM_POSTGRES_POOL_TIMEOUT_SECONDS=10
